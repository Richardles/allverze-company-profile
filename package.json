{
  "name": "allverze-company-profile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "node server/server.mjs",
    "build": "npm run build -w client",
    "lint": "npm run lint -w client && npm run lint -w server",
    "server": "node server/server.mjs",
    "start": "node server/server.mjs",
    "preview": "npm run preview -w client",
    "logs:contact": "node scripts/contact-log.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}